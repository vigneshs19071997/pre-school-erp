# ---- Neon Postgres ----
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# Long random string (run: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Cloudflare R2 storage ----
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="r2-access-key"
R2_SECRET_ACCESS_KEY="r2-secret-key"
R2_BUCKET="preschool-files"

# ---- School defaults (can be changed later in Settings) ----
SCHOOL_NAME="Little Sprouts Preschool"
STUDENT_ID_PREFIX="LS"
APP_TIMEZONE="Asia/Kolkata"

# ---- First admin account (used by npm run db:seed) ----
ADMIN_EMAIL="admin@school.com"
ADMIN_PASSWORD="Admin@123"
